{
  "name": "quist",
  "version": "0.1.0",
  "description": "Quist.ai — cloud storage unit. Your files and folders live on the server; move them across PCs, edit, snapshot, and build server-side.",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node test/dev-server.js",
    "migrate": "node -e \"require('./server/db').migrate().then(()=>process.exit(0))\"",
    "test": "node --test --test-force-exit test/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chokidar": "^3.6.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.4.0",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "embedded-postgres": "^17.5.0-beta.15"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.5.0-beta.15": true
  }
}
