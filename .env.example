# --- required ---
DATABASE_URL=postgres://user:pass@host:5432/quist

# --- optional ---
PORT=3000
NODE_ENV=production

# where project workspaces are materialised on disk (ephemeral is fine; Postgres is the source of truth)
WORKSPACE_ROOT=/tmp/quist-ws
# local (run shells in this container, what Railway supports) | docker (one container per project)
SANDBOX_DRIVER=local
# docker driver only
SANDBOX_IMAGE=quist-sandbox
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
SANDBOX_PIDS=512
SANDBOX_NETWORK=none            # or an --internal docker network that only reaches the egress proxy
SANDBOX_HTTP_PROXY=             # http://quist-proxy:8888 (see sandbox/proxy/)

# limits
EXEC_TIMEOUT_MS=120000          # default run_shell timeout
EXEC_TIMEOUT_MAX_MS=3600000
EXEC_MAX_OUTPUT=524288
BUILD_TIMEOUT_MS=1200000
BUILD_CONCURRENCY=1
BUILD_KEEP=20
MAX_UPLOAD_BYTES=209715200
MAX_ARTIFACT_BYTES=536870912
WORKSPACE_IDLE_MS=1800000
