# Quist shell profile. Loaded by `bash --rcfile` for the interactive terminal
# and via BASH_ENV for one-shot exec/build commands.
[ -f /etc/bash.bashrc ] && . /etc/bash.bashrc 2>/dev/null
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env" 2>/dev/null
export PATH="/opt/quist/bin:$PATH:/usr/local/go/bin:$HOME/go/bin:$HOME/.cargo/bin"
export TERM="${TERM:-xterm-256color}"
export CLICOLOR=1
export LS_COLORS='di=38;2;217;119;87:ln=38;2;180;180;180:ex=38;2;237;237;237'
alias ls='ls --color=auto -F 2>/dev/null || ls -F'
alias ll='ls -la'
shopt -s histappend checkwinsize 2>/dev/null
# orange prompt, matches the UI: ~/<project> $
PS1='\[\e[38;2;217;119;87m\]~/${QUIST_PROJECT} $\[\e[0m\] '
if [ -n "$PS1" ] && [ -z "$QUIST_BANNER_DONE" ] && [[ $- == *i* ]]; then
  export QUIST_BANNER_DONE=1
  printf '\e[38;2;110;110;110munit shell — type `help` for the built-ins\e[0m\n'
fi
